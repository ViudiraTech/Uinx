# TEST: codegen.asm.cross-nop
# EXPECT: compile-pass

dontneed std

unsafe func arch_barrier() -> unit:
    asm("nop", volatile, clobber("memory"))
    return

func kernel_entry() -> i32:
    unsafe:
        arch_barrier()
    return 0
