# TEST: safety.borrow.dangling-through-call
# EXPECT: compile-fail
# EXPECT-DIAGNOSTIC: E0404

func pass_reference(value: ref i32) -> ref i32:
    return value

func bad_indirect_reference() -> ref i32:
    val local = 11
    return pass_reference(borrow local)
