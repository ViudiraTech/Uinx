# TEST: safety.borrow.write-through-moved-ref
# EXPECT: compile-fail
# EXPECT-DIAGNOSTIC: E0400
# Writing through a moved mutref is a use after move.

func main() -> i32:
    var x = 1
    val r = borrow mut x
    val moved = r
    deref r = 2
    deref moved = 3
    return 0
