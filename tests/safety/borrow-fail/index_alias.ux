# TEST: safety.borrow.index-alias
# EXPECT: compile-fail
# EXPECT-DIAGNOSTIC: E0401

struct SliceMut[T]:
    data: mutptr T
    len: usize

func conflict(var slice: SliceMut[i32]) -> unit:
    val first = borrow mut slice[0]
    val second = borrow slice[1]
    first
    second

func main() -> i32:
    return 0
