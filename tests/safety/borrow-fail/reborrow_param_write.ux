# TEST: safety.borrow.reborrow-param-write
# EXPECT: compile-fail
# EXPECT-DIAGNOSTIC: E0403
# Writing through a reference parameter while its reborrow is live.

func f(p: mutref i32) -> unit:
    val a = borrow mut deref p
    deref p = 5
    deref a = 4
    return
func main() -> i32:
    return 0
