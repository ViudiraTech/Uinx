# TEST: safety.borrow.reborrow-after-move
# EXPECT: compile-fail
# EXPECT-DIAGNOSTIC: E0400
# A moved mutref cannot be reborrowed by a later call.

func inc(r: mutref i32) -> unit:
    deref r += 1
    return
func main() -> i32:
    var x = 1
    val r = borrow mut x
    val moved = r
    inc(r)
    inc(moved)
    return 0
