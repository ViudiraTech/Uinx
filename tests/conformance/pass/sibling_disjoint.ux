# TEST: conformance.positive.sibling-disjoint
# EXPECT: compile-pass
# Sibling fields are disjoint places (Rust places_conflict).

struct Pair:
    left: i32
    right: i32

func use_both(left: mutref i32, right: ref i32) -> i32:
    deref left += deref right
    return deref left

func main() -> i32:
    var pair = new Pair(left=20, right=22)
    val l = borrow mut pair.left
    val r = borrow pair.right
    val out = use_both(l, r)
    return out - 42
