# TEST: conformance.positive.trait-method
# EXPECT: compile-pass

trait Readable:
    func read(self: ref Self) -> i32

struct Cell:
    value: i32

extend Cell with Readable:
    func read(self: ref Self) -> i32:
        return self.value

func main() -> i32:
    val cell = new Cell(value=42)
    return cell.read() - 42
