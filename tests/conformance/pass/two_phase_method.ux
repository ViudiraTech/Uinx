# TEST: conformance.positive.two-phase-method
# EXPECT: compile-pass
# Two-phase borrows: receiver reservation coexists with shared arg borrows.

struct Counter:
    value: i32

extend Counter:
    public func len(self: ref Self) -> i32:
        return self.value
    public func push(self: mutref Self, delta: i32) -> unit:
        self.value += delta
        return

func main() -> i32:
    var counter = new Counter(value=40)
    counter.push(counter.len())
    return counter.value - 42
