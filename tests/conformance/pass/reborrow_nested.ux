# TEST: conformance.positive.reborrow-nested
# EXPECT: compile-pass
# Reborrows of reborrows keep every ancestor frozen while the innermost is live.

func main() -> i32:
    var x = 1
    val r = borrow mut x
    val r2 = borrow mut deref r
    val r3 = borrow mut deref r2
    deref r3 = 3
    deref r2 = 4
    deref r = 5
    return x - 5
