# Uinx core::atomic
# The uinx_atomic_* ABI is compiler-intrinsic when the ordering argument is a
# compile-time constant. Hosted builds may still provide runtime fallbacks.
dontneed std

public struct AtomicU64:
    shared value: u64

unsafe extern "C" func uinx_atomic_load_u64(ptr: ptr u64, order: i32) -> u64
unsafe extern "C" func uinx_atomic_store_u64(ptr: mutptr u64, value: u64, order: i32) -> unit
unsafe extern "C" func uinx_atomic_fetch_add_u64(ptr: mutptr u64, value: u64, order: i32) -> u64
unsafe extern "C" func uinx_atomic_compare_exchange_u64(ptr: mutptr u64, expected: mutptr u64, desired: u64, success_order: i32, failure_order: i32) -> i32

extend AtomicU64:
    public func load(self: ref Self) -> u64:
        unsafe:
            return uinx_atomic_load_u64((borrow self.value) as ptr u64, 1)

    public func load_relaxed(self: ref Self) -> u64:
        unsafe:
            return uinx_atomic_load_u64((borrow self.value) as ptr u64, 0)

    public func store(self: mutref Self, value: u64) -> unit:
        unsafe:
            uinx_atomic_store_u64((borrow mut self.value) as mutptr u64, value, 2)
        return

    public func store_relaxed(self: mutref Self, value: u64) -> unit:
        unsafe:
            uinx_atomic_store_u64((borrow mut self.value) as mutptr u64, value, 0)
        return

    public func fetch_add(self: mutref Self, value: u64) -> u64:
        unsafe:
            return uinx_atomic_fetch_add_u64((borrow mut self.value) as mutptr u64, value, 3)

    public func compare_exchange(self: mutref Self, expected: mutref u64, desired: u64) -> bool:
        unsafe:
            val result = uinx_atomic_compare_exchange_u64(
                (borrow mut self.value) as mutptr u64,
                expected as mutptr u64,
                desired,
                4,
                1,
            )
            return result != 0
