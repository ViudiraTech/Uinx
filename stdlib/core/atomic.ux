# ---- AtomicBool (0/1 over u8 storage; LLVM i1 is not byte-sized) ----
public struct AtomicBool:
    shared value: u8

extend AtomicBool:
    public func load(self: ref Self) -> bool:
        unsafe:
            val raw = uinx_atomic_load_u8((borrow self.value) as ptr u8, 1)
            return raw != 0
    public func load_relaxed(self: ref Self) -> bool:
        unsafe:
            val raw = uinx_atomic_load_u8((borrow self.value) as ptr u8, 0)
            return raw != 0
    public func store(self: mutref Self, value: bool) -> unit:
        unsafe:
            var raw: u8 = 0
            if value:
                raw = 1
            uinx_atomic_store_u8((borrow mut self.value) as mutptr u8, raw, 2)
        return
    public func store_relaxed(self: mutref Self, value: bool) -> unit:
        unsafe:
            var raw: u8 = 0
            if value:
                raw = 1
            uinx_atomic_store_u8((borrow mut self.value) as mutptr u8, raw, 0)
        return
    public func swap(self: mutref Self, value: bool) -> bool:
        unsafe:
            var raw: u8 = 0
            if value:
                raw = 1
            val prev = uinx_atomic_exchange_u8((borrow mut self.value) as mutptr u8, raw, 3)
            return prev != 0
    public func compare_exchange(self: mutref Self, expected: mutref u8, desired: u8) -> bool:
        unsafe:
            val ok = uinx_atomic_compare_exchange_u8((borrow mut self.value) as mutptr u8, expected as mutptr u8, desired, 4, 1)
            return ok != 0
