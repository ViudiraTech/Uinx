{
  "name": "Uinx",
  "scopeName": "source.uinx",
  "fileTypes": ["ux", "uxh"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#directives" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.uinx",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.uinx",
          "match": "//.*$"
        },
        {
          "name": "comment.block.uinx",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.uinx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.uinx",
              "match": "\\\\(n|r|t|\"|\\\\|0|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.uinx",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.uinx",
              "match": "\\\\(n|r|t|'|\\\\|0)"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hex.uinx",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.uinx",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.integer.octal.uinx",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.uinx",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.uinx",
          "match": "\\b\\d[\\d_]*\\b"
        },
        {
          "name": "constant.language.boolean.uinx",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.uinx",
          "match": "^\\s*\\b(need|dontneed|no_std|smp)\\b"
        },
        {
          "name": "constant.language.smp.uinx",
          "match": "\\b(auto|manual|strict)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.uinx",
          "match": "\\b(?:func|def|fn|struct|enum|trait|extend|impl|with|const|static|val|var)\\b"
        },
        {
          "name": "keyword.modifier.uinx",
          "match": "\\b(?:public|pub|unsafe|async|concurrent|extern|mut|shared|percpu)\\b"
        },
        {
          "name": "keyword.control.uinx",
          "match": "\\b(?:if|elif|else|while|for|in|loop|break|continue|return|scope|pass|where|as|use|mod|await|asm|fence|compiler_fence)\\b"
        },
        {
          "name": "keyword.ownership.uinx",
          "match": "\\b(?:move|borrow|deref|new|ref|mutref|ptr|mutptr|self|Self|dyn)\\b"
        },
        {
          "name": "keyword.operator.logical.uinx",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.uinx",
          "match": "\\b(?:unit|never|bool|char|str|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|isize|usize|f32|f64)\\b"
        },
        {
          "name": "storage.type.stdlib.uinx",
          "match": "\\b(?:Slice|SliceMut|AtomicU8|AtomicU16|AtomicU32|AtomicU64|AtomicBool|SpinLock|TicketSpinLock|RwSpinLock|SeqLock|Once|Barrier|Option|Result|Vec|String|Box|Rc|Arc|HashMap|Mutex)\\b"
        },
        {
          "name": "storage.type.marker.uinx",
          "match": "\\b(?:Send|Sync|Copy|Drop|Sized)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.uinx",
          "begin": "\\b(func|def|fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.uinx" },
            "2": { "name": "entity.name.function.uinx" }
          },
          "end": ":",
          "patterns": [{ "include": "#types" }, { "include": "#keywords" }]
        },
        {
          "name": "entity.name.function.call.uinx",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.method.uinx",
          "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "variable.language.self.uinx",
          "match": "\\b(?:self|Self)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.uinx",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.uinx",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|="
        },
        {
          "name": "keyword.operator.arithmetic.uinx",
          "match": "\\+|-|\\*|/|%|<<|>>|&|\\||\\^|~|!"
        },
        {
          "name": "punctuation.separator.colon.uinx",
          "match": ":"
        },
        {
          "name": "punctuation.separator.uinx",
          "match": "[,;.]"
        }
      ]
    }
  }
}
